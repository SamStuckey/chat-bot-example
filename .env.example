# Copy to .env (never committed) and fill in the two required values.
OPENAI_API_KEY=
# Any long random string, for example from `openssl rand -hex 32`. It derives each
# user's opaque prompt-cache key.
PENNY_CACHE_KEY_SECRET=

# Optional overrides; every other setting has a default in src/penny/config.py.
# PENNY_CHAT_MODEL=openai:gpt-6.1-terra
# PENNY_COMPACTION_MODEL=openai:gpt-6-luna
# PENNY_HISTORY_BUDGET_TOKENS=20000
# PENNY_DEFAULT_TIMEZONE=UTC
